# ---- Database (Postgres + pgvector from docker compose on localhost:5433) ----
DATABASE_URL=postgresql+asyncpg://psi:psi@localhost:5433/psi

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# ---- URLs ----
# Public URL of the Next.js app (used to build assistant links + embed code)
PUBLIC_APP_URL=http://localhost:3000

# ---- LLM (free tier: https://console.groq.com/keys) ----
LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional fully-local alternative:
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ---- Embeddings (local, free) ----
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# ---- Limits ----
MAX_DOCUMENTS=10
MAX_PAGES=20
MAX_FILE_MB=10
